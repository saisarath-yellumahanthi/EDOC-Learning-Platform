# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Auth & Profiles Configuration
# Replace these placeholders with your Supabase project URL and publishable (anon) key.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Server-side Gemini API Key (accessed exclusively in server.ts / server/gemini.ts)
# Automatically injected in AI Studio from Settings > Secrets. Never expose with VITE_.
GEMINI_API_KEY=""
